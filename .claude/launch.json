{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "badamoa-hub",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "badamoa",
        "hub",
        "run",
        "--home",
        ".badamoa/hub",
        "--port",
        "8470",
        "--no-open"
      ],
      "env": {
        "BADAMOA_GPU_BUSY_MEMORY_PCT": "101",
        "BADAMOA_GPU_BUSY_UTIL_PCT": "101"
      },
      "port": 8470
    },
    {
      "name": "badamoa-hub-check",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "badamoa",
        "hub",
        "run",
        "--home",
        ".badamoa/check",
        "--port",
        "8471",
        "--no-open"
      ],
      "env": {
        "BADAMOA_GPU_BUSY_MEMORY_PCT": "101",
        "BADAMOA_GPU_BUSY_UTIL_PCT": "101"
      },
      "port": 8471
    },
    {
      "name": "badamoa-hub-readme",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "badamoa",
        "hub",
        "run",
        "--home",
        ".badamoa/readme",
        "--port",
        "8472",
        "--public-url",
        "http://192.168.0.10:8470",
        "--no-open"
      ],
      "env": {
        "BADAMOA_GPU_BUSY_MEMORY_PCT": "101",
        "BADAMOA_GPU_BUSY_UTIL_PCT": "101"
      },
      "port": 8472
    }
  ]
}
